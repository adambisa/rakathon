{
  "name": "@prostapaper/extraction",
  "version": "0.0.0",
  "private": true,
  "description": "PDF and image text extraction producing ExtractedDocument, with bundled MuPDF and Tesseract assets",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts",
    "#scripts/*": "./scripts/*.ts",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./assets": "./src/assets.ts",
    "./reading-order": "./src/reading-order.ts"
  },
  "scripts": {
    "extract": "node scripts/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "sheet": "node scripts/sheet.ts",
    "sheet:diagram": "node scripts/sector-diagram.ts",
    "sheet:labels": "node scripts/sector-labels.ts",
    "sheet:overlay": "node scripts/sheet-overlay.ts",
    "sheet:template": "node scripts/sector-template.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@aws/bedrock-token-generator": "1.1.0",
    "@prostapaper/contracts": "workspace:*",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@tesseract.js-data/ces": "1.0.0",
    "mupdf": "1.28.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@prostapaper/config": "workspace:*",
    "@types/node": "catalog:",
    "pdf-lib": "^1.17.1",
    "typescript": "catalog:"
  }
}
