{
  "name": "@prostapaper/document-ingest",
  "version": "0.0.0",
  "private": true,
  "description": "Submit-driven Lambda: extracts case documents and invokes mapping",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "build": "node build.ts",
    "lint": "eslint . --max-warnings 0",
    "qa": "node scripts/qa.ts",
    "qa:prepare": "node scripts/qa-prepare.ts",
    "qa:score": "node scripts/qa-score.ts",
    "qa:test": "node scripts/qa-test.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@prostapaper/contracts": "workspace:*",
    "@prostapaper/db": "workspace:*",
    "@prostapaper/extraction": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@prostapaper/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
