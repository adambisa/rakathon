{
  "name": "prostapaper",
  "private": true,
  "description": "ProstaPaper \u2014 Rakathon 2026 monorepo (prostate pathology report \u2192 structured record \u2192 REDCap)",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "22.23.3"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo boundaries && turbo run codegen test typecheck lint lint:root typecheck:root check:shell check:terraform:style format:check knip",
    "check:boundaries": "turbo boundaries",
    "check:shell": "for script in infra/*.sh; do bash -n \"$script\" || exit; done",
    "check:terraform:style": "node infra/check-terraform-format.mjs",
    "codegen": "turbo run codegen",
    "containers:integration": "RUN_INTEGRATION_TESTS=1 bash infra/test-containers.sh",
    "containers:smoke": "bash infra/test-containers.sh",
    "db:down": "turbo run db:down --filter=@prostapaper/db",
    "db:generate": "turbo run db:generate --filter=@prostapaper/db",
    "db:seed": "turbo run db:seed --filter=@prostapaper/db",
    "db:up": "turbo run db:up --filter=@prostapaper/db",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check . && prettier --ignore-path /dev/null --check infra/README.md",
    "format:terraform": "terraform fmt -recursive infra && node infra/check-terraform-format.mjs",
    "knip": "knip --reporter ${KNIP_REPORTER:-symbols}",
    "lint": "turbo run lint",
    "lint:root": "eslint eslint.config.ts lint-staged.config.ts --max-warnings 0",
    "prepare": "husky",
    "preview:docker": "turbo run preview:run",
    "preview:run": "docker compose up -d --build --wait app",
    "qa:extraction": "pnpm --filter @prostapaper/document-ingest qa",
    "qa:prepare": "pnpm --filter @prostapaper/document-ingest qa:prepare",
    "qa:score": "pnpm --filter @prostapaper/document-ingest qa:score",
    "qa:test": "pnpm --filter @prostapaper/document-ingest qa:test",
    "test:containers": "turbo run containers:smoke",
    "test:production": "turbo run containers:integration",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@prostapaper/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "husky": "~9.1.7",
    "jiti": "~2.7.0",
    "knip": "~6.39.0",
    "lint-staged": "~17.6.0",
    "prettier": "catalog:",
    "turbo": "~2.11.7",
    "typescript": "catalog:"
  },
  "prettier": "@prostapaper/config/prettier"
}
